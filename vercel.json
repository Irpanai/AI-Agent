{
  "version": 2,
  "rewrites": [
    {
      "source": "/set_webhook",
      "destination": "/api/set_webhook"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/panel",
      "destination": "/api/panel"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/briefing",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/recap",
      "schedule": "0 10 * * *"
    }
  ]
}
