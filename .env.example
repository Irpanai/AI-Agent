# ==========================================
# KONFIGURASI TELEGRAM BOT & GEMINI AI GUDANG
# ==========================================

# 1. Token Bot dari Telegram (@BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 2. API Key Google Gemini dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. ID Spreadsheet Google Sheets atau URL Lengkap Spreadsheet
# Contoh URL: https://docs.google.com/spreadsheets/d/101s0zYjcC8UI63hwUMciYPxwF4wQVNpNx6vafCTrE20/edit
SPREADSHEET_ID_OR_URL=your_spreadsheet_id_or_url_here

# 4. Kredensial Service Account Google Cloud:
# - Untuk Local Development: simpan file credentials.json di root project
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# - Khusus Deployment Vercel: Masukkan SELURUH isi JSON dari credentials.json ke variabel ini:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# 5. Pengaturan Superadmin & Admin Gudang
SUPERADMIN_TELEGRAM_IDS=8979934843
ADMIN_TELEGRAM_IDS=7957273991
ADMIN_PIN=1234
ADMIN_PHONE_NUMBERS=

# 6. Pengaturan Server & URL Panel Mini App
PORT=5000
DEBUG=False
# Ganti dengan domain Vercel Anda setelah deploy (contoh: https://nama-proyek.vercel.app/panel)
WEB_APP_URL=http://localhost:5000/panel
