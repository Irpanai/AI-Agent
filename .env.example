# ==========================================
# KONFIGURASI TELEGRAM BOT & GEMINI AI GUDANG
# ==========================================

# Token Bot dari Telegram (@BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# API Key Google Gemini dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ID Spreadsheet Google Sheets atau URL Lengkap Spreadsheet
# Contoh URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# ID Spreadsheet adalah string acak di antara /d/ dan /edit (misal: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms)
SPREADSHEET_ID_OR_URL=your_spreadsheet_id_or_url_here

# Nama file kredensial Service Account Google Cloud (disimpan di folder root proyek)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Pengaturan Admin (Daftar ID Telegram Admin atau PIN)
ADMIN_TELEGRAM_IDS=12345678,87654321
ADMIN_PIN=1234

# Pengaturan Server Flask & Web App Panel
PORT=5000
DEBUG=False
WEB_APP_URL=http://localhost:5000/panel
